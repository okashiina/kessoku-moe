# Copy to .env and adjust. All optional -- sane defaults are built in.

PORT=8088

# Comma-separated Auto priority (resolver tries these in this order). Forced providers can still be tested from the UI.
# Public ids: kaa, animepahe, allanime, hianime. AniLiberty is research-only (Russian audio).
# kaa (KickAssAnime) = clean/RAW JP audio + soft VTT subs -- the primary pick.
PROVIDERS=kaa,animepahe,allanime

# FlareSolverr endpoint (the docker-compose service). Used to pass Cloudflare.
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Optional residential/ISP proxy passed to FlareSolverr for challenged hosts.
# Leave blank until the PoC proves the VPS IP alone gets blocked.
PROXY_URL=

# Resolved-source cache TTL (ms) and subtitle cache TTL (ms).
SOURCE_TTL_MS=900000
SUBTITLE_TTL_MS=86400000

# Circuit breaker: failures within window before a provider is skipped, + cooldown.
BREAKER_THRESHOLD=4
BREAKER_COOLDOWN_MS=120000

# Global rate limit for /watch only (the scrape + FlareSolverr fan-out). A GLOBAL
# cap, not per-IP: the box sits behind a tunnel with no reliable per-client IP and
# X-Forwarded-For is spoofable. Protects the box + slows provider bans
# (docs/STREAMING-ROADMAP.md section 13). /hls /file /subs stay unthrottled. Defaults shown.
SOURCE_WATCH_BURST=12
SOURCE_WATCH_RPM=20

# Allowed CORS origins for the frontend (comma-separated, or * for any).
CORS_ORIGINS=*

# OpenSubtitles API key (Phase 3 -- Indonesian/English subtitles). Optional for now.
OPENSUBTITLES_API_KEY=
