# Frontend environment variables. Copy to .env.local and fill in.
# .env.local is gitignored; production values live on Railway.
#
# NEXT_PUBLIC_* are baked into the client bundle at build time (declare a matching
# ARG in the Dockerfile for Railway builds). Everything else is server-only and
# is read at runtime inside /pages/api routes; it never reaches the browser.

# --- Self-hosted source pipeline (Option B) -------------------------------
# Point the frontend at the source-service for the direct HLS player. Unset in
# production so Railway stays on the embed fallback. See docs/STREAMING-ROADMAP.md.
NEXT_PUBLIC_SOURCE_SERVICE_URL=http://localhost:8088

# --- AniList OAuth (authorization code grant) -----------------------------
# Client id is public (bundled); the secret is server-only (used by
# /api/auth/anilist to exchange the code for a token). Redirect on the AniList
# app must be <origin>/auth/callback.
NEXT_PUBLIC_ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- AI watch companion (docs/STREAMING-ROADMAP.md §11) -------------------
# Server-only OpenAI API configuration. Leave the key empty until you create one
# at https://platform.openai.com/api-keys. Never expose this as NEXT_PUBLIC_*.
COMPANION_API_KEY=
COMPANION_API_BASE=https://api.openai.com/v1
# Cost-sensitive, high-volume GPT model; use gpt-5.6-terra for a quality upgrade.
COMPANION_MODEL=gpt-5.6-luna
# Optional cheaper/fast model for vibe-search routes. Blank = use COMPANION_MODEL.
# COMPANION_CHEAP_MODEL=gpt-5.6-luna
# Gemini alternative:
#   COMPANION_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   COMPANION_MODEL=gemini-2.5-flash
# Groq alternative:
#   COMPANION_API_BASE=https://api.groq.com/openai/v1
#   COMPANION_MODEL=llama-3.3-70b-versatile
# Provider fallback. If the primary API errors, quota-limits, or returns no text,
# the watch companion tries these before giving up. You can either set one
# explicit fallback pair, or just provide GEMINI_API_KEY / GROQ_API_KEY /
# OPENROUTER_API_KEY / OPENAI_API_KEY and the server auto-adds those providers.
# If only COMPANION_UNCENSORED_API_KEY exists, OpenRouter is used as the final
# text fallback so a quota-hit primary does not make the companion go silent.
# COMPANION_FALLBACK_API_KEY=
# COMPANION_FALLBACK_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# COMPANION_FALLBACK_MODEL=gemini-2.5-flash
# COMPANION_FALLBACKS=[{"name":"gemini","base":"https://generativelanguage.googleapis.com/v1beta/openai","key":"...","model":"gemini-2.5-flash"}]

# Optional uncensored model for the "unhinged" tone ONLY (opt-in, 18+). The
# default models are safety-aligned; an uncensored model (OpenRouter, OpenAI-
# compatible) lets unhinged go further. Blank = unhinged falls back to default.
# Key: https://openrouter.ai/keys  ·  Models: https://openrouter.ai/models
COMPANION_UNCENSORED_API_KEY=
COMPANION_UNCENSORED_API_BASE=https://openrouter.ai/api/v1
COMPANION_UNCENSORED_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Companion rate limit + daily cost cap (Rule 8 / docs/STREAMING-ROADMAP.md §13).
# In-memory, single Railway instance. One chat turn is ~2 upstream calls, so these
# sit below the raw provider limits. All optional; defaults shown. On Gemini free
# (15 RPM) lower COMPANION_GLOBAL_RPM; Groq (30 RPM) is fine at the default.
# COMPANION_IP_BURST=5        # per-IP burst (turns)
# COMPANION_IP_RPM=8          # per-IP sustained turns/min
# COMPANION_GLOBAL_BURST=10   # global burst (turns) across all users
# COMPANION_GLOBAL_RPM=8      # global sustained turns/min
# COMPANION_DAILY_MAX=500     # hard ceiling on turns/day (resets at UTC midnight)

# --- Database (push notifications; later per-episode ratings + comments) ---
# Server-only, runtime. A Postgres connection string (Neon free tier works).
# Unset = the app runs fully local-first and the push/db API routes answer 503,
# so nothing breaks. Run the migration (frontend/drizzle) against this before
# deploying the feature. NEVER a NEXT_PUBLIC_* or a Docker build arg.
DATABASE_URL=
# DATABASE_POOL_MAX=8         # pg pool size (optional)

# --- Web Push (new-episode notifications) ---------------------------------
# VAPID keypair signs every push. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is bundled (NEXT_PUBLIC_*, needs a Dockerfile ARG); the PRIVATE
# key + subject are server-only. CRON_SECRET guards the /api/push/trigger cron.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kessoku.moe
CRON_SECRET=
# PUSH_LOOKBACK_SECONDS=10800 # how far back the cron scans for aired episodes (3h)
# Push write rate limits (Rule 8; in-memory, single instance). Defaults shown.
# PUSH_IP_BURST=20  PUSH_IP_RPM=30  PUSH_OWNER_BURST=20  PUSH_OWNER_RPM=30
# PUSH_GLOBAL_BURST=100  PUSH_GLOBAL_RPM=120
